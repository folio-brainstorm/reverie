{
  "name": "@reveriejs/core",
  "version": "1.0.1",
  "description": "Core package for the Rêverie raster painting engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/folio-brainstorm/reverie.git",
    "directory": "core"
  },
  "homepage": "https://github.com/folio-brainstorm/reverie#readme",
  "bugs": "https://github.com/folio-brainstorm/reverie/issues",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rendering": {
      "types": "./dist/src/core/rendering/index.d.ts",
      "import": "./dist/src/core/rendering/index.js"
    },
    "./rendering/internal": {
      "types": "./dist/src/core/rendering/internal.d.ts",
      "import": "./dist/src/core/rendering/internal.js"
    },
    "./history": {
      "types": "./dist/src/core/history/index.d.ts",
      "import": "./dist/src/core/history/index.js"
    },
    "./document": {
      "types": "./dist/src/core/document/index.d.ts",
      "import": "./dist/src/core/document/index.js"
    },
    "./project": {
      "types": "./dist/src/core/project/index.d.ts",
      "import": "./dist/src/core/project/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --debug=false",
    "build:debug": "node scripts/build.mjs --debug=true",
    "dev": "node scripts/build.mjs --debug=true --watch",
    "dev:no-debug": "node scripts/build.mjs --debug=false --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
