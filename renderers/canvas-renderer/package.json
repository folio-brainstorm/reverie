{
  "name": "@reveriejs/canvas-renderer",
  "version": "1.0.0",
  "description": "Rendering backends for the Rêverie raster painting engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/folio-brainstorm/reverie.git",
    "directory": "renderers/canvas-renderer"
  },
  "homepage": "https://github.com/folio-brainstorm/reverie#readme",
  "bugs": "https://github.com/folio-brainstorm/reverie/issues",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:no-debug": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose --includeTaskLocation",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reveriejs/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
