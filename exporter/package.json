{
  "name": "@reveriejs/exporter",
  "version": "1.0.0",
  "description": "Export a fixed size RGBA buffer or encoded image file.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/folio-brainstorm/reverie.git",
    "directory": "exporter"
  },
  "homepage": "https://github.com/folio-brainstorm/reverie#readme",
  "bugs": "https://github.com/folio-brainstorm/reverie/issues",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:no-debug": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose --includeTaskLocation",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reveriejs/core": "workspace:*",
    "@stacksjs/ts-webp": "^0.1.3",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
